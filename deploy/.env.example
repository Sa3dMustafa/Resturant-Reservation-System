# Images
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/savora-frontend:latest
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/savora-backend:latest

# PostgreSQL
POSTGRES_DB=savora
POSTGRES_USER=savora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://savora:CHANGE_ME_STRONG_PASSWORD@postgres:5432/savora?schema=public

# App
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET

# Notifications
SMTP_USER=
SMTP_PASS=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
CANCEL_URL=http://YOUR_EC2_PUBLIC_IP/en/reservation/cancel

# Seed admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_NAME=Administrator
